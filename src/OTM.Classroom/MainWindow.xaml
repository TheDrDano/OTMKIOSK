<Window x:Class="Otm.Kiosk.Classroom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleKioskOS Classroom" Height="640" Width="980" MinHeight="560" MinWidth="820"
        Background="#E8EDF2">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FF6B1A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D9550D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1D2935" />
            <Setter Property="BorderBrush" Value="#C7D0DA" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SIMPLEKIOSKOS Classroom" FontSize="27" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Remote/local manager foundation for labs and classrooms" Foreground="#526171" Margin="1,4,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="A production of OTM (Oklahoma Tech Maker)" Foreground="#64748B" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Connect" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="Manager URL" Foreground="#344756" FontWeight="SemiBold" />
                    <TextBox x:Name="ManagerUrlBox" Text="http://localhost:47821" Height="34" Margin="0,4,0,10" />
                    <TextBlock Text="Admin PIN" Foreground="#344756" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PinBox" Height="34" Margin="0,4,0,12" />
                    <Button Content="Refresh Device" Click="Refresh_Click" />
                    <Button Content="Generate Pairing Code" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="Pairing_Click" />
                    <TextBox x:Name="PairingCodeBox" IsReadOnly="True" Height="34" Margin="0,10,0,0" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
                    <Separator Margin="0,16,0,14" />
                    <Button Content="Lock Station" Style="{StaticResource SecondaryButton}" Click="Lock_Click" />
                    <Button Content="Unlock 15 Minutes" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="Unlock_Click" />
                    <TextBlock Text="Remote cloud sync is intentionally not enabled yet. This app talks to the local manager API now and becomes the Classroom shell later." Foreground="#64748B" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#111827" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="DeviceNameText" Text="No station connected" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="DeviceStatusText" Text="Connect to a SimpleKioskOS station to view status." Foreground="#C8D3DD" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="ActivityBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
