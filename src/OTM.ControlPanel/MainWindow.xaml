<Window x:Class="Otm.Kiosk.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleKioskOS Control Panel" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Background="#E8EDF2">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FF6B1A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D9550D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1D2935" />
            <Setter Property="BorderBrush" Value="#C7D0DA" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#8F1D14" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="22,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Width="260" Height="58" Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock Text="Simple local lockdown control panel" Foreground="#526171" FontSize="13" Margin="2,6,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Admin PIN" Foreground="#344756" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <PasswordBox x:Name="PinBox" Width="190" Height="38" Margin="0,0,10,0" ToolTip="Admin PIN" />
                    <Button Content="Refresh" Width="106" Click="Refresh_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Simple Controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Use these first. Edit JSON only when you need advanced policy changes." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Border Background="#F8FAFC" BorderBrush="#D7E1EA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock x:Name="StatusText" Text="Service status unknown" TextWrapping="Wrap" LineHeight="20" />
                        </Border>
                        <CheckBox x:Name="EnableEnforcementCheckBox" Content="Turn blocking on" Margin="0,0,0,8" />
                        <CheckBox x:Name="StrictWhitelistCheckBox" Content="Only allowed apps can run" Margin="0,0,0,8" />
                        <Button Content="Save Protection Mode" Margin="0,0,0,12" Style="{StaticResource SecondaryButton}" Click="SaveProtectionMode_Click" />
                        <UniformGrid Columns="2" Rows="2">
                            <Button Content="Unlock 15m" Margin="0,0,6,6" Click="Unlock_Click" />
                            <Button Content="Lock Now" Margin="6,0,0,6" Style="{StaticResource DangerButton}" Click="Lock_Click" />
                            <Button Content="Exam Template" Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="ExamTemplate_Click" />
                            <Button Content="Lab Template" Margin="6,6,0,0" Style="{StaticResource SecondaryButton}" Click="LabTemplate_Click" />
                        </UniformGrid>
                        <Button Content="Save Advanced Policy" Margin="0,14,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Export this setup or import a saved profile. Import keeps this PC's admin PIN." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <Button Content="Import" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="ImportProfile_Click" />
                            <Button Content="Export" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="ExportProfile_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Remote Manager" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="RemoteStatusText" Text="LAN pairing not loaded." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <CheckBox x:Name="RemoteEnabledCheckBox" Content="Enable remote manager" Margin="0,0,0,8" />
                        <TextBlock Text="Server URL" Foreground="#344756" FontWeight="SemiBold" FontSize="12" />
                        <TextBox x:Name="RemoteServerUrlBox" Height="32" Margin="0,3,0,8" ToolTip="Example: https://manager.simplekioskos.com" />
                        <TextBlock Text="Organization ID" Foreground="#344756" FontWeight="SemiBold" FontSize="12" />
                        <TextBox x:Name="RemoteOrganizationBox" Height="32" Margin="0,3,0,8" />
                        <TextBlock Text="Device name" Foreground="#344756" FontWeight="SemiBold" FontSize="12" />
                        <TextBox x:Name="RemoteDeviceAliasBox" Height="32" Margin="0,3,0,8" />
                        <CheckBox x:Name="AllowRemotePolicyPushCheckBox" Content="Allow remote policy changes" Margin="0,0,0,6" />
                        <CheckBox x:Name="AllowRemoteUnlockCheckBox" Content="Allow remote unlock" Margin="0,0,0,6" />
                        <CheckBox x:Name="AllowRemoteUpdateCheckBox" Content="Allow remote update approval" Margin="0,0,0,10" />
                        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,2,0,8" />
                        <CheckBox x:Name="UpdateEnabledCheckBox" Content="Check for updates" Margin="0,0,0,8" />
                        <TextBlock Text="Manifest URL" Foreground="#344756" FontWeight="SemiBold" FontSize="12" />
                        <TextBox x:Name="UpdateManifestUrlBox" Height="32" Margin="0,3,0,8" ToolTip="HTTPS JSON manifest with version and installerUrl" />
                        <TextBlock Text="Channel" Foreground="#344756" FontWeight="SemiBold" FontSize="12" />
                        <TextBox x:Name="UpdateChannelBox" Height="32" Margin="0,3,0,10" />
                        <Button Content="Save Remote Settings" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="SaveRemoteSettings_Click" />
                        <Button Content="Check Updates" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="CheckUpdates_Click" />
                        <Button Content="Generate Pairing Code" Style="{StaticResource SecondaryButton}" Click="GeneratePairingCode_Click" />
                        <TextBox x:Name="PairingCodeBox" IsReadOnly="True" Height="34" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
                        <TextBlock x:Name="UpdateStatusText" Text="" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Admin" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Change PIN" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPinBox" Height="32" Margin="0,0,0,8" />
                        <Button Content="Update PIN" Height="34" Click="ChangePin_Click" />
                        <TextBlock Text="First-run default PIN: 123456. Change this before strict lockdown testing." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="1" Background="White" BorderBrush="#D8DEE6">
                <TabItem Header="Simple Apps">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#F8FAFC" BorderBrush="#D7E1EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="4" Text="Add an app" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Name" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="AppDisplayNameBox" Height="34" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Process" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="AppProcessNameBox" Height="34" ToolTip="Example: chrome.exe" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="EXE path" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="AppPathBox" Height="34" ToolTip="Optional full path to the app EXE" />
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="3" Content="Browse" Width="92" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}" Click="BrowseApp_Click" />

                                <CheckBox x:Name="AddLauncherCheckBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Show allowed app in kiosk launcher" IsChecked="True" Margin="0,12,0,0" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Allow App" Width="112" Margin="0,0,8,0" Click="AllowApp_Click" />
                                    <Button Content="Block App" Width="112" Style="{StaticResource DangerButton}" Click="BlockApp_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Allowed Apps" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <DataGrid x:Name="AllowedAppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="140" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Content="Remove Selected Allowed App" Height="38" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveAllowedApp_Click" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Blocked Apps" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <DataGrid x:Name="BlockedAppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="140" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Content="Remove Selected Blocked App" Height="38" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveBlockedApp_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Websites">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#F8FAFC" BorderBrush="#D7E1EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="Add a website" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Domain or URL" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="WebsiteBox" Height="34" ToolTip="Example: testing.example.edu or youtube.com" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Allow Site" Width="112" Margin="0,0,8,0" Click="AllowWebsite_Click" />
                                    <Button Content="Block Site" Width="112" Style="{StaticResource DangerButton}" Click="BlockWebsite_Click" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="BrowserEnabledCheckBox" Content="Website rules on" Margin="0,0,18,0" />
                                    <CheckBox x:Name="WhitelistOnlyCheckBox" Content="Only allowed websites can open" Margin="0,0,18,0" />
                                    <CheckBox x:Name="BrowserBlockDownloadsCheckBox" Content="Block browser downloads" Margin="0,0,18,0" />
                                    <Button Content="Save Website Mode" Height="34" Style="{StaticResource SecondaryButton}" Click="SaveBrowserMode_Click" />
                                    <Button Content="Apply Edge/Chrome Policy" Height="34" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="ApplyBrowserPolicy_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Allowed Websites" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ListBox x:Name="AllowedSitesList" Grid.Row="1" SelectionMode="Single" />
                                    <Button Grid.Row="2" Content="Remove Selected Allowed Site" Height="38" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveAllowedWebsite_Click" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Blocked Websites" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ListBox x:Name="BlockedSitesList" Grid.Row="1" SelectionMode="Single" />
                                    <Button Grid.Row="2" Content="Remove Selected Blocked Site" Height="38" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveBlockedWebsite_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Advanced Policy">
                    <Grid Margin="10">
                        <TextBox x:Name="PolicyTextBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderBrush="#CAD5DE"
                                 Background="#FBFCFD"
                                 TextWrapping="NoWrap" />
                    </Grid>
                </TabItem>
                <TabItem Header="Activity Logs">
                    <Grid Margin="10">
                        <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="170" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="170" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border x:Name="NoticePanel"
                Panel.ZIndex="20"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="620"
                Margin="24"
                Background="#F7FAFC"
                BorderBrush="#C8D4DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <DockPanel>
                <Border x:Name="NoticeAccent" DockPanel.Dock="Left" Width="5" Background="#176B87" CornerRadius="3" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle" Text="Notice" Foreground="#17202A" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="NoticeText" Text="" Foreground="#405466" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="SafeTestBanner"
                Panel.ZIndex="10"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="760"
                Margin="24,94,24,0"
                Background="#FFF7ED"
                BorderBrush="#FDBA74"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <TextBlock Text="Safe test mode: enforcement is off. This PC is not actively blocking apps or websites."
                       Foreground="#9A3412"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
