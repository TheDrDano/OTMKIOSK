<Window x:Class="Otm.Kiosk.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTM Kiosk" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Background="#EEF2F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#176B87" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#145B73" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#176B87" />
            <Setter Property="BorderBrush" Value="#B8C7D2" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#9F2D2D" />
            <Setter Property="BorderBrush" Value="#812424" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#18242E" Padding="22,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="OTM Kiosk" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Local lockdown control panel" Foreground="#AFC1CF" FontSize="13" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Admin PIN" Foreground="#D7E1EA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <PasswordBox x:Name="PinBox" Width="180" Height="34" Margin="0,0,8,0" ToolTip="Admin PIN" />
                    <Button Content="Refresh" Width="96" Click="Refresh_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Device Status" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Background="#F3F7FA" BorderBrush="#D7E1EA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock x:Name="StatusText" Text="Service status unknown" TextWrapping="Wrap" LineHeight="20" />
                        </Border>
                        <UniformGrid Columns="2" Rows="2">
                            <Button Content="Unlock 15m" Margin="0,0,6,6" Click="Unlock_Click" />
                            <Button Content="Lock Now" Margin="6,0,0,6" Style="{StaticResource DangerButton}" Click="Lock_Click" />
                            <Button Content="Exam Template" Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="ExamTemplate_Click" />
                            <Button Content="Lab Template" Margin="6,6,0,0" Style="{StaticResource SecondaryButton}" Click="LabTemplate_Click" />
                        </UniformGrid>
                        <Button Content="Save Policy JSON" Margin="0,14,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Admin" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Change PIN" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPinBox" Height="32" Margin="0,0,0,8" />
                        <Button Content="Update PIN" Height="34" Click="ChangePin_Click" />
                        <TextBlock Text="First-run default PIN: 123456" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TabControl Grid.Column="1" Background="White" BorderBrush="#D8DEE6">
                <TabItem Header="Policy">
                    <Grid Margin="10">
                        <TextBox x:Name="PolicyTextBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderBrush="#CAD5DE"
                                 Background="#FBFCFD"
                                 TextWrapping="NoWrap" />
                    </Grid>
                </TabItem>
                <TabItem Header="Logs">
                    <Grid Margin="10">
                        <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="170" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="170" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
