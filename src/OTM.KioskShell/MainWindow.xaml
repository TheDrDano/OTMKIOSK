<Window x:Class="Otm.Kiosk.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SimpleKioskOS"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#E8EDF2"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FF6B1A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D9550D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#151A20" />
            <Setter Property="BorderBrush" Value="#D7DEE6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1D2935" />
            <Setter Property="BorderBrush" Value="#C7D0DA" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#8F1D14" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151A20" BorderBrush="#CFD7E1" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Width="238" Height="58" Stretch="Uniform" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock Text="Secure workspace" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock x:Name="StatusText" Text="Device locked" Foreground="#C8D3DD" FontSize="13" TextWrapping="Wrap" Margin="1,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#242A31" BorderBrush="#343C45" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,22,0,14">
                    <StackPanel>
                        <TextBlock Text="Approved Launchers" Foreground="#F8FAFC" FontWeight="SemiBold" />
                        <TextBlock Text="Apps and exam sites allowed by this policy." Foreground="#AAB6C2" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LaunchersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource LauncherButton}"
                                        Margin="0,0,0,10"
                                        Tag="{Binding}"
                                        Click="Launch_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="Local-first controls work offline." Foreground="#AAB6C2" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="26,22,26,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="WorkspaceTitle" Text="Locked Workspace" Foreground="#111827" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="WorkspaceSubtitle" Text="Choose an approved app or exam site from the left." Foreground="#526171" FontSize="14" Margin="1,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <TextBlock x:Name="ClockText" Foreground="#1F2937" FontSize="14" />
                </Border>
            </DockPanel>

            <Grid Grid.Row="1" Margin="26,0,26,26">
                <Border x:Name="IdleWorkspace" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680">
                            <Image Source="pack://application:,,,/Assets/simplekioskos_bottom.png" Width="410" Height="245" Stretch="Uniform" />
                            <TextBlock Text="This station is protected" Foreground="#111827" FontSize="42" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="Start an approved application or exam site from the launcher. Blocked activity will be stopped and logged locally." Foreground="#526171" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="WebWorkspace" Visibility="Collapsed" Background="Black" BorderBrush="#233746" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <wv2:WebView2 x:Name="ExamBrowser" />
                </Border>

                <Border x:Name="AppWorkspace" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="28">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                            <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Width="330" Height="82" Stretch="Uniform" />
                            <TextBlock x:Name="AppWorkspaceTitle" Text="Application workspace active" Foreground="#111827" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,0" />
                            <TextBlock x:Name="AppWorkspaceText" Text="Approved apps can remain open together. Use the launcher to start another app." Foreground="#526171" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Button x:Name="AdminCornerButton"
                Grid.ColumnSpan="2"
                Content="Admin"
                Width="112"
                Height="44"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Style="{StaticResource SecondaryButton}"
                Click="ToggleAdmin_Click" />

        <Border x:Name="AdminPanel" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="460" Margin="0,0,30,30" Background="#F8FAFC" BorderBrush="#C8D4DE" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Admin Access" FontSize="18" FontWeight="SemiBold" Foreground="#17202A" />
                        <TextBlock Text="Manage this kiosk locally." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Hide" Width="82" Height="34" Style="{StaticResource SecondaryButton}" Click="ToggleAdmin_Click" />
                </DockPanel>
                <TextBlock Text="PIN" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox x:Name="PinBox" Height="38" Margin="0,0,0,12" />
                <UniformGrid Columns="2" Rows="2">
                    <Button Content="Unlock 15m" Margin="0,0,6,6" Click="Unlock_Click" />
                    <Button Content="Lock" Margin="6,0,0,6" Style="{StaticResource DangerButton}" Click="Lock_Click" />
                    <Button Content="Manager" Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="Manager_Click" />
                    <Button Content="Control Panel" Margin="6,6,0,0" Style="{StaticResource SecondaryButton}" Click="ControlPanel_Click" />
                </UniformGrid>
                <Button Content="Refresh Status" Margin="0,14,0,0" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                <Separator Margin="0,14,0,12" />
                <TextBlock Text="Remote Manager" FontWeight="SemiBold" Foreground="#17202A" />
                <TextBlock Text="Offline local mode. Pairing will be enabled when cloud management is added." Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8" />
                <TextBox Text="Not connected" Height="32" IsReadOnly="True" Foreground="#64748B" />
            </StackPanel>
        </Border>

        <Border x:Name="NoticePanel"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="720"
                Margin="24"
                Background="#F7FAFC"
                BorderBrush="#C8D4DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <DockPanel>
                <Border x:Name="NoticeAccent" DockPanel.Dock="Left" Width="5" Background="#176B87" CornerRadius="3" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle" Text="Notice" Foreground="#17202A" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="NoticeText" Text="" Foreground="#405466" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
