    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="LeftRail" Grid.Column="0" Background="#0B1118" BorderBrush="#263241" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="29" Padding="10">
                        <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Width="238" Height="58" Stretch="Uniform" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock Text="Launchpad" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock x:Name="StatusText" Text="Device locked" Foreground="#C8D3DD" FontSize="13" TextWrapping="Wrap" Margin="1,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#111A24" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,14">
                    <StackPanel>
                        <TextBlock Text="Workspace apps" Foreground="#F8FAFC" FontWeight="SemiBold" />
                        <TextBlock Text="Choose an app, site, or saved workspace." Foreground="#AAB6C2" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LaunchersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource LauncherButton}"
                                        Margin="0,0,0,10"
                                        Tag="{Binding}"
                                        Click="Launch_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="Local controls work offline." Foreground="#AAB6C2" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="WorkspaceHeader" Grid.Row="0" Margin="26,18,26,14" Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WorkspaceTitle" Text="Workspace Launchpad" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock x:Name="WorkspaceSubtitle" Text="Choose an approved app, website, or workspace from the launcher." Foreground="#AAB6C2" FontSize="14" Margin="1,4,0,0" />
                        <Border x:Name="SafeTestBanner" Visibility="Collapsed" Background="#3A210F" BorderBrush="#FFB36B" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,12,0,0">
                            <TextBlock Text="Safe test mode: managed rules are off. Apps and websites are not actively limited." Foreground="#FDBA74" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#17202A" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="7" Padding="12,8" VerticalAlignment="Top" Margin="20,0,0,0">
                        <TextBlock x:Name="ClockText" Foreground="#DDE5EF" FontSize="14" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,0,26,14">
                <Border x:Name="IdleWorkspace" Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680">
                            <Border Width="430" Height="170" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="85" Padding="30,22" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/simplekioskos_bottom.png" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Ready to start" Foreground="#F8FAFC" FontSize="44" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0" />
                            <TextBlock Text="Pick a workspace from the launcher. Apps stay organized here while this station remains managed." Foreground="#AAB6C2" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="SimpleKioskOS Launchpad" Foreground="#7E8B99" FontSize="13" TextAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="WebWorkspace" Visibility="Collapsed" Background="Black" BorderBrush="#233746" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="10,8">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Web workspace" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="WebFullscreenButton" DockPanel.Dock="Right" Width="126" Height="34" MinHeight="34" Padding="10,0" Style="{StaticResource SecondaryButton}" Click="ToggleWebFullscreen_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconFullscreen}" />
                                        </Viewbox>
                                        <TextBlock x:Name="WebFullscreenText" Text="Fullscreen" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                        <wv2:WebView2 x:Name="ExamBrowser" Grid.Row="1" />
                    </Grid>
                </Border>

                <Border x:Name="AppWorkspace" Visibility="Collapsed" Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="10" Padding="28">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                            <Border Width="360" Height="112" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="56" Padding="18">
                                <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="AppWorkspaceTitle" Text="Application workspace active" Foreground="#F8FAFC" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,0" />
                            <TextBlock x:Name="AppWorkspaceText" Text="Approved apps can remain open together. Use the launcher to start another app." Foreground="#AAB6C2" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ShellTaskbar" Grid.Row="2" Margin="26,0,26,18" Background="#0B1118" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Width="32" Height="32" Background="#242A31" BorderBrush="#3D4651" BorderThickness="1" CornerRadius="7" Margin="0,0,10,0">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="#FF6B1A" Data="{StaticResource IconDisplay}" />
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Open apps" Foreground="#F8FAFC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="SimpleKioskOS Launchpad" Foreground="#AAB6C2" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Background="#1F2937" BorderBrush="#3D4651" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="OpenAppsCountText" Text="0" Foreground="#DDE5EF" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <ItemsControl x:Name="ManagedAppsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}"
                                            Style="{StaticResource TaskbarButton}"
                                            MinWidth="150"
                                            Margin="0,0,8,0"
                                            Tag="{Binding}"
                                            Click="ManagedApp_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Style="{StaticResource TaskbarIconButton}" Click="SignOutSystem_Click" ToolTip="Sign out of Windows">
                            <Grid>
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconExit}" />
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TaskbarIconButton}" Margin="8,0,0,0" Click="RestartSystem_Click" ToolTip="Restart Windows">
                            <Grid>
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconRefresh}" />
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TaskbarIconButton}" Margin="8,0,0,0" Background="#2B1512" BorderBrush="#6E2A20" Foreground="#FDBA74" Click="ShutdownSystem_Click" ToolTip="Shut down Windows">
                            <Grid>
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconPower}" />
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button x:Name="AdminTaskbarButton" Width="46" Height="42" Margin="8,0,0,0" Padding="0" Style="{StaticResource SecondaryButton}" Click="ToggleAdmin_Click" ToolTip="Admin">
                            <Grid>
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconGear}" />
                                </Viewbox>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Button x:Name="AdminCornerButton"
                Grid.ColumnSpan="2"
                Width="48"
                Height="48"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,100"
                Padding="0"
                Style="{StaticResource SecondaryButton}"
                Visibility="Collapsed"
                Click="ToggleAdmin_Click"
                ToolTip="Admin">
            <Grid>
                <Viewbox Width="17" Height="17">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconGear}" />
                </Viewbox>
            </Grid>
        </Button>

        <Border x:Name="AdminPanel" Grid.ColumnSpan="2" Panel.ZIndex="80" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="460" Margin="0,0,30,30" Background="#F8FAFC" BorderBrush="#C8D4DE" BorderThickness="1" CornerRadius="8" Padding="18">
            <Border.Effect>
                <DropShadowEffect Color="#1D2935" Opacity="0.28" BlurRadius="24" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Admin Access" FontSize="18" FontWeight="SemiBold" Foreground="#17202A" />
                        <TextBlock Text="Manage this kiosk locally." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Width="82" Height="34" Style="{StaticResource SecondaryButton}" Click="ToggleAdmin_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconClose}" />
                            </Viewbox>
                            <TextBlock Text="Hide" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <StackPanel x:Name="AdminSignInPanel">
                    <TextBlock Text="PIN or recovery key" Foreground="#344756" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PinBox" Height="40" Margin="0,0,0,10" KeyDown="PinBox_KeyDown" />
                    <Button Height="42" Click="AdminSignIn_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconUnlock}" />
                            </Viewbox>
                            <TextBlock Text="Sign in" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Admin tools are hidden until sign-in." Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel x:Name="AdminActionsPanel" Visibility="Collapsed">
                <UniformGrid Columns="2" Rows="4">
                    <Button Margin="0,0,6,6" Click="Unlock_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconUnlock}" />
                            </Viewbox>
                            <TextBlock Text="Unlock 15m" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,6" Style="{StaticResource DangerButton}" Click="Lock_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconLock}" />
                            </Viewbox>
                            <TextBlock Text="Lock" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="ControlPanel_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconSliders}" />
                            </Viewbox>
                            <TextBlock Text="Control Panel" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,6,0,0" Style="{StaticResource DangerButton}" Click="EmergencyUnlock_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconWarning}" />
                            </Viewbox>
                            <TextBlock Text="Emergency" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="ExitShell_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconExit}" />
                            </Viewbox>
                            <TextBlock Text="Exit Shell" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,6,0" Style="{StaticResource SecondaryButton}" Click="CheckStationUpdate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconRefresh}" />
                            </Viewbox>
                            <TextBlock Text="Check Update" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,6,0,0" Style="{StaticResource SecondaryButton}" Click="DownloadStationUpdate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource IconDisplay}" />
                            </Viewbox>
                            <TextBlock Text="Download" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <Separator Margin="0,14,0,12" />
                <TextBlock Text="Local administration only" FontWeight="SemiBold" Foreground="#17202A" />
                <TextBlock Text="Use the native Control Panel for setup, profiles, app rules, website rules, and logs." Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="NoticePanel"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="720"
                Margin="24"
                Background="#F7FAFC"
                BorderBrush="#C8D4DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <DockPanel>
                <Border x:Name="NoticeAccent" DockPanel.Dock="Left" Width="5" Background="#176B87" CornerRadius="3" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle" Text="Notice" Foreground="#17202A" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="NoticeText" Text="" Foreground="#405466" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
