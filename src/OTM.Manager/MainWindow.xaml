<Window x:Class="Otm.Kiosk.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleKioskOS Remote Manager" Height="720" Width="1180" MinHeight="640" MinWidth="980"
        Background="#080D12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FF6B1A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D9550D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#8F1D14" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SimpleKioskOS Remote Manager" FontSize="29" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="Connect to multiple SimpleKioskOS stations over LAN or VPN" Foreground="#AAB6C2" Margin="1,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="28" Padding="12,6">
                    <Image Source="pack://application:,,,/Assets/simplekioskos_side.png" Width="220" Height="54" Stretch="Uniform" />
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stations" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                        <TextBlock Text="Name" Foreground="#DDE5EF" FontWeight="SemiBold" />
                        <TextBox x:Name="StationNameBox" Height="34" Margin="0,4,0,10" />
                        <TextBlock Text="Station API URL" Foreground="#DDE5EF" FontWeight="SemiBold" />
                        <TextBox x:Name="StationUrlBox" Text="http://localhost:47821" Height="34" Margin="0,4,0,10" />
                        <UniformGrid Columns="2">
                            <Button Content="Save Station" Margin="0,0,6,0" Click="SaveStation_Click" />
                            <Button Content="Remove" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveStation_Click" />
                        </UniformGrid>
                        <Button Content="Refresh All" Margin="0,10,0,12" Style="{StaticResource SecondaryButton}" Click="RefreshAll_Click" />
                    </StackPanel>

                    <ListBox x:Name="StationsList"
                             Grid.Row="1"
                             Background="#F8FAFC"
                             BorderBrush="#2E3A47"
                             DisplayMemberPath="Summary"
                             SelectionChanged="StationsList_SelectionChanged" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#111827" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="SelectedStationText" Text="No station selected" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedStatusText" Text="Add or select a station to manage it." Foreground="#C8D3DD" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#0F1722" BorderBrush="#263241" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Station controls" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Use the station admin PIN to refresh, control, and update the selected workstation." Foreground="#AAB6C2" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock Text="Admin PIN" Foreground="#DDE5EF" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PinBox" Height="34" Margin="0,4,0,12" />
                        <UniformGrid Columns="4">
                            <Button Content="Refresh" Margin="0,0,6,0" Click="RefreshSelected_Click" />
                            <Button Content="Lock" Margin="6,0,6,0" Style="{StaticResource SecondaryButton}" Click="Lock_Click" />
                            <Button Content="Unlock" Margin="6,0,6,0" Style="{StaticResource SecondaryButton}" Click="Unlock_Click" />
                            <Button Content="Load Rules" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="LoadRules_Click" />
                            <Button Content="Updates" Margin="0,8,6,0" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click" />
                            <Button Content="Download Update" Margin="6,8,6,0" Style="{StaticResource SecondaryButton}" Click="DownloadStationUpdate_Click" />
                            <Button Content="Restart" Margin="6,8,6,0" Style="{StaticResource SecondaryButton}" Click="Restart_Click" />
                            <Button Content="Shutdown" Margin="6,8,6,0" Style="{StaticResource DangerButton}" Click="Shutdown_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16">
                    <TabControl>
                        <TabItem Header="App Rules">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name" Foreground="#344756" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="1" Text="Process name" Foreground="#344756" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="2" Text="EXE path" Foreground="#344756" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,4" />
                                    <TextBox x:Name="AppDisplayNameBox" Grid.Row="1" Height="34" Margin="0,0,8,0" ToolTip="Display name, for example Microsoft Flight Simulator" />
                                    <TextBox x:Name="AppProcessBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,8,0" ToolTip="Process name, for example chrome.exe" />
                                    <TextBox x:Name="AppPathBox" Grid.Row="1" Grid.Column="2" Height="34" Margin="0,0,8,0" ToolTip="Optional full EXE path" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Allow" Margin="0,0,8,0" Click="AllowApp_Click" />
                                    <Button Grid.Row="1" Grid.Column="4" Content="Block" Style="{StaticResource DangerButton}" Click="BlockApp_Click" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Allowed apps" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DataGrid x:Name="AllowedAppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Content="Remove Selected Allowed" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveAllowedApp_Click" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Blocked apps" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DataGrid x:Name="BlockedAppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="2" Content="Remove Selected Blocked" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveBlockedApp_Click" />
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Websites">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="102" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Website domain or URL" Foreground="#344756" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,4" />
                                    <TextBlock Grid.Column="1" Text="Mode" Foreground="#344756" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,4" />
                                    <TextBox x:Name="WebsiteBox" Grid.Row="1" Height="34" Margin="0,0,8,0" ToolTip="Domain or URL, for example testing.example.edu" />
                                    <CheckBox x:Name="WhitelistOnlyCheckBox" Grid.Row="1" Grid.Column="1" Content="Allowlist only" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Save Mode" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="SaveWebsiteMode_Click" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Allow Site" Margin="0,0,8,0" Click="AllowWebsite_Click" />
                                    <Button Grid.Row="1" Grid.Column="4" Content="Block Site" Style="{StaticResource DangerButton}" Click="BlockWebsite_Click" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Allowed websites" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ListBox x:Name="AllowedSitesList" Grid.Row="1" />
                                    <Button Grid.Row="2" Content="Remove Selected Allowed Site" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveAllowedWebsite_Click" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Blocked websites" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ListBox x:Name="BlockedSitesList" Grid.Row="1" />
                                    <Button Grid.Row="2" Content="Remove Selected Blocked Site" Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveBlockedWebsite_Click" />
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Monitoring">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F8FAFC" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Remote monitoring" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock Grid.Row="1"
                                                   Text="SimpleKioskOS includes the secure monitoring configuration layer. Live encrypted screen viewing will use a separate user-session monitor agent so it can capture the desktop correctly and avoid exposing raw VNC."
                                                   Foreground="#526171"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,14" />
                                        <UniformGrid Grid.Row="2" Columns="2">
                                            <CheckBox x:Name="MonitoringEnabledCheckBox" Content="Enable monitoring for this station" Margin="0,0,12,10" />
                                            <CheckBox x:Name="MonitoringScreenViewCheckBox" Content="Allow screen viewing when agent is installed" Margin="12,0,0,10" />
                                            <CheckBox x:Name="MonitoringApprovalCheckBox" Content="Require local/admin approval" Margin="0,0,12,10" />
                                            <CheckBox x:Name="MonitoringLanOnlyCheckBox" Content="LAN/VPN only" Margin="12,0,0,10" />
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Refresh seconds" FontWeight="SemiBold" Foreground="#344756" VerticalAlignment="Center" />
                                    <TextBox x:Name="MonitoringRefreshSecondsBox" Grid.Column="1" Height="34" Text="5" />

                                    <TextBlock Grid.Row="1" Text="Transport" FontWeight="SemiBold" Foreground="#344756" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <ComboBox x:Name="MonitoringTransportBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,10,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="secure-agent-planned" />
                                        <ComboBoxItem Content="vnc-over-vpn-planned" />
                                        <ComboBoxItem Content="tls-screen-agent-planned" />
                                    </ComboBox>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <Button Content="Load Monitoring" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Click="LoadMonitoring_Click" />
                                            <Button Content="Save Monitoring" Margin="6,0,0,0" Click="SaveMonitoring_Click" />
                                        </UniformGrid>
                                        <TextBox x:Name="MonitoringStatusBox"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="120"
                                                 Background="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Activity">
                            <Grid Margin="0,12,0,0">
                                <TextBox x:Name="ActivityBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
