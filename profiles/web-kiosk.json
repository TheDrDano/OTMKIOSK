{
  "name": "Web Kiosk",
  "enforcement": {
    "enabled": true,
    "strictApplicationWhitelist": true,
    "restartRequiredApps": true,
    "fullscreenOverlay": false,
    "processScanIntervalMs": 1000,
    "temporaryUnlockMinutes": 15
  },
  "allowedApps": [
    { "displayName": "Microsoft Edge", "processName": "msedge.exe" },
    { "displayName": "Google Chrome", "processName": "chrome.exe" }
  ],
  "browser": {
    "enabled": true,
    "whitelistOnly": true,
    "blockDownloads": true,
    "allowedSites": ["https://library.example.org/*"],
    "blockedSites": ["*"]
  }
}
