{
  "name": "Library Mode",
  "enforcement": {
    "enabled": true,
    "strictApplicationWhitelist": true,
    "restartRequiredApps": true,
    "fullscreenOverlay": false,
    "processScanIntervalMs": 1000,
    "temporaryUnlockMinutes": 15
  },
  "allowedApps": [],
  "launchers": [
    {
      "id": "library-browser",
      "displayName": "Library Browser",
      "type": "web",
      "workspaceMode": "exam",
      "url": "https://www.worldcat.org/",
      "allowedSites": ["https://www.worldcat.org/*", "https://*.overdrive.com/*"]
    }
  ],
  "blockedApps": [
    { "displayName": "Task Manager", "processName": "Taskmgr.exe" },
    { "displayName": "Command Prompt", "processName": "cmd.exe" },
    { "displayName": "PowerShell", "processName": "powershell.exe" },
    { "displayName": "Registry Editor", "processName": "regedit.exe" },
    { "displayName": "Windows Settings", "processName": "SystemSettings.exe" },
    { "displayName": "Microsoft Store", "processName": "WinStore.App.exe" }
  ],
  "browser": {
    "enabled": true,
    "whitelistOnly": true,
    "blockDownloads": true,
    "allowedSites": ["https://www.worldcat.org/*", "https://*.overdrive.com/*"],
    "blockedSites": ["*"]
  }
}
