{
  "name": "Flight Simulator",
  "enforcement": {
    "enabled": true,
    "strictApplicationWhitelist": true,
    "restartRequiredApps": true,
    "fullscreenOverlay": false,
    "processScanIntervalMs": 1000,
    "temporaryUnlockMinutes": 15
  },
  "allowedApps": [
    { "displayName": "Microsoft Flight Simulator", "processName": "FlightSimulator.exe" },
    { "displayName": "Joystick Utility", "processName": "joystick.exe" },
    { "displayName": "Charts Browser", "processName": "msedge.exe" }
  ],
  "launchers": [
    {
      "id": "flight-simulator",
      "displayName": "Microsoft Flight Simulator",
      "type": "app",
      "workspaceMode": "appOwner",
      "processName": "FlightSimulator.exe",
      "path": "FlightSimulator.exe",
      "allowMultiMonitorOwnership": true
    },
    {
      "id": "charts",
      "displayName": "Charts and Maps",
      "type": "web",
      "workspaceMode": "exam",
      "url": "https://skyvector.com/",
      "allowedSites": ["https://skyvector.com/*"]
    }
  ],
  "blockedApps": [
    { "displayName": "Task Manager", "processName": "Taskmgr.exe" },
    { "displayName": "Command Prompt", "processName": "cmd.exe" },
    { "displayName": "PowerShell", "processName": "powershell.exe" },
    { "displayName": "Registry Editor", "processName": "regedit.exe" },
    { "displayName": "Windows Settings", "processName": "SystemSettings.exe" },
    { "displayName": "Microsoft Store", "processName": "WinStore.App.exe" }
  ],
  "browser": {
    "enabled": true,
    "whitelistOnly": true,
    "blockDownloads": true,
    "allowedSites": ["https://skyvector.com/*"],
    "blockedSites": ["*"]
  }
}
