{
  "name": "Esports Mode",
  "enforcement": {
    "enabled": true,
    "strictApplicationWhitelist": true,
    "restartRequiredApps": true,
    "fullscreenOverlay": false,
    "processScanIntervalMs": 1000,
    "temporaryUnlockMinutes": 15
  },
  "allowedApps": [
    { "displayName": "Steam", "processName": "steam.exe" },
    { "displayName": "Discord", "processName": "Discord.exe" },
    { "displayName": "Tournament Launcher", "processName": "tournament-launcher.exe" }
  ],
  "launchers": [
    { "id": "steam", "displayName": "Steam", "type": "app", "workspaceMode": "lab", "processName": "steam.exe", "path": "steam.exe" },
    { "id": "discord", "displayName": "Discord", "type": "app", "workspaceMode": "lab", "processName": "Discord.exe", "path": "Discord.exe" },
    { "id": "tournament", "displayName": "Tournament Launcher", "type": "app", "workspaceMode": "lab", "processName": "tournament-launcher.exe", "path": "tournament-launcher.exe" }
  ],
  "blockedApps": [
    { "displayName": "Task Manager", "processName": "Taskmgr.exe" },
    { "displayName": "Command Prompt", "processName": "cmd.exe" },
    { "displayName": "PowerShell", "processName": "powershell.exe" },
    { "displayName": "Registry Editor", "processName": "regedit.exe" },
    { "displayName": "Windows Settings", "processName": "SystemSettings.exe" },
    { "displayName": "Microsoft Store", "processName": "WinStore.App.exe" }
  ],
  "browser": {
    "enabled": true,
    "whitelistOnly": false,
    "blockDownloads": true,
    "allowedSites": [],
    "blockedSites": ["youtube.com", "tiktok.com", "instagram.com", "facebook.com", "x.com", "twitter.com", "reddit.com"]
  }
}
